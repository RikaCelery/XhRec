@startuml XhRec 自动录制引擎组件架构
!theme plain
skinparam backgroundColor #FEFDF9
skinparam component {
  BackgroundColor #EAF2E3
  BorderColor #5B8C5A
  ArrowColor #444444
}
skinparam package {
  BackgroundColor #F6F8FC
  BorderColor #7A9CC6
  FontColor #1F3864
}
skinparam node {
  BackgroundColor #FCE9D9
  BorderColor #C77B42
}

actor "用户/扩展" as User
actor "直播平台" as Platform

package "自动录制引擎 (XhRec)" {

  package "事件/调度层" {
    [LiveEventSource\nWebSocket 订阅] as WS
    [EventBus / RequestBus] as BUS
    [SchedulerComponent\n录制调度] as Sched
  }

  package "会话控制层" {
    [SessionComponent\n会话状态机/拉流决策] as Session
    [ApiClient\n平台 API] as API
    [M3u8Parser / Decrypter\nPlaylist 解析] as M3U8
  }

  package "流媒体管道" {
    [DownloaderComponent\n并发分片下载] as DL
    [CdnSelector\nCDN 优选/冷却] as CDN
    [OrderedEmitter\n分片有序重排] as OE
    [DataChannel\n流数据通道] as DC
    [WriterComponent\nMP4 写入/封装] as Writer
    [MseStore\n实时预览缓存] as MSE
  }

  package "后处理层" {
    [PostProcessorComponent\n按房间队列后处理] as PP
    [ffmpeg / ffprobe / shell] as Tool
  }
}

' ---- external actors ----
User --> Sched : 控制/启停
User --> Session : 设置/查询
Platform --> WS : WS 推送
Platform --> Session : 拉取 playlist
Platform --> DL : HLS 分片下载

' ---- internal flows ----
WS --> BUS : RoomStatusChanged / LiveMessage
BUS --> Sched : 状态事件
Sched --> Session : DoStart / DoStop / DoBreak
Session --> BUS : 查询 RoomConfig / DecryptKey / 支付账号
Session --> API : 房间信息/群组秀/Token
Session --> M3U8 : 解析 master/media playlist
Session --> DL : DoDownload / DoCutPoint
DL --> CDN : 选择/记录速度
CDN --> Platform : 重写后的 CDN URL
DL --> OE : 并发完成结果
OE --> DC : StreamData/StreamStart/StreamEnd
DC --> Writer : 流数据
DC --> MSE : 实时预览副本
Writer --> BUS : FileReady
BUS --> PP : FileReady
PP --> Tool : 执行后处理命令
PP --> BUS : FileProcessed

note right of Session
  状态: Idle / Armed / Fetching / Recording / Closing
  职责: 选画质、轮询 playlist、限时/限大小、
       自动支付群组秀、触发 CutPoint
end note

note right of DL
  直连 + 代理竞争下载；
  每房间 Semaphore 限并发；
  OrderedEmitter 保证分片顺序。
end note

@enduml
