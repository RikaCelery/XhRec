<configuration  scan="true" scanPeriod="30 seconds">

    <conversionRule conversionWord="maskedMsg"
        converterClass="github.rikacelery.v3.utils.MaskingMessageConverter" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{MM-dd HH:mm:ss} %-5level %logger{2} - %maskedMsg%n</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>


    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/xhrec.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>logs/xhrec.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep 30 days of history -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %maskedMsg%n</pattern>
        </encoder>
    </appender>
    <!--
      INFO by default: DEBUG is per-room, per-poll chatter that grows the file fast without being
      read in normal operation. The dashboard's log-level picker (or POST /log/level) raises it to
      DEBUG/TRACE while chasing a specific room, and that choice persists in xhrec.json.
      The pattern deliberately omits %M (method name): it walks the stack on every event, and the
      logger name plus the message already say where a line came from.
    -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="OFF"/>
    <!--
      Noisy per-connection Netty loggers that Ktor's engine trips on ordinary client behaviour.
      Pinned off on their own, independently of the io.netty level above, so raising io.netty to
      DEBUG/TRACE to inspect other Netty internals cannot bring the flood back:
        - DefaultChannelPipeline: WARN whenever an exception reaches the tail of the pipeline
          (aborted requests, dropped SSE / keep-alive connections).
        - ApplicationProtocolNegotiationHandler: WARN "TLS handshake failed" / "Failed to select
          the application-level protocol" (Ktor 3 enables HTTP/2 + ALPN by default) for clients
          that do not speak ALPN — plain-HTTP probes, scanners, health checks. Client noise, not
          a server fault.
    -->
    <logger name="io.netty.channel.DefaultChannelPipeline" level="OFF"/>
    <logger name="io.netty.handler.ssl.ApplicationProtocolNegotiationHandler" level="OFF"/>
    <logger name="ch.qos.logback" level="WARN"/>
    <logger name="io.ktor" level="OFF"/>
</configuration>